<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa el número a marcar (Ejercicio 8.2 - Dial)"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etTelefonoDial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número de teléfono"
        android:inputType="phone"
        android:layout_marginBottom="16dp" />

    <ImageButton
        android:id="@+id/ibTelefonoDial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Abrir marcador"
        android:onClick="onDialClick"
        android:padding="20dp"
        android:src="@drawable/ic_telefono" />

    <TextView
        android:id="@+id/tvEstadoDial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Presiona para abrir el marcador"
        android:textSize="14sp"
        android:textAlignment="center" />

</LinearLayout>